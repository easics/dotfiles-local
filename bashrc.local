#
# ~/.bashrc
#

# A better experience for python breakpoint debugging.
which pudb &> /dev/null && export PYTHONBREAKPOINT="pudb.set_trace"

# Sometimes alias rm='rm -i' is set up, but this just leads to the
# nasty habit of always using `rm -f`, which hides error messages.
[[ $(type -t rm) == "alias" ]] && unalias rm

# To prevent an extra accidental Ctrl-D from closing the terminal.
set -o ignoreeof

# This prevents that reusing previous commands removes the duplicates in `history`.
unset HISTCONTROL

# To update SSH_AGENT environment variables in tmux
# after an SSH connection was dropped and re-initialized.
# See: https://blog.mcpolemic.com/2016/10/01/reconciling-tmux-and-ssh-agent-forwarding.html
alias ssh_agent_update='eval $(tmux show-env -s | grep "^SSH_")'

alias cdw='cd $DIGROOT'
alias pdw='pushd $DIGROOT'
Green="\033[0;32m"
Yellow="\033[0;33m"
Blue="\033[1;34m"
Normal="\033[0m"

function git_info {
  if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ]
  then
    echo -e "($(basename `git rev-parse --show-toplevel`) |$(git branch --show-current)|) "
  fi
}

export PS1="\[$Blue\]\u@\h: \[$Yellow\]\$(git_info)\[$Green\]\W\[$Normal\]\n$ "

#
# # ex - archive extractor
# # usage: ex <file>
ex ()
{
  if [ -f $1 ] ; then
    case $1 in
      *.tar.bz2)   tar xjf $1   ;;
      *.tar.gz)    tar xzf $1   ;;
      *.bz2)       bunzip2 $1   ;;
      *.rar)       unrar x $1     ;;
      *.gz)        gunzip $1    ;;
      *.tar)       tar xf $1    ;;
      *.tbz2)      tar xjf $1   ;;
      *.tgz)       tar xzf $1   ;;
      *.zip)       unzip $1     ;;
      *.Z)         uncompress $1;;
      *.7z)        7z x $1      ;;
      *)           echo "'$1' cannot be extracted via ex()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

[ -f ~/.bash_completion ] && . ~/.bash_completion
